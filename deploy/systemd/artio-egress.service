[Unit]
Description=Block Artio container egress to cloud metadata and the tailnet
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# One rule per ExecStart, so a failed rule fails the unit instead of being masked by a later one that
# happens to succeed. Each is idempotent (check with -C, insert with -I only if missing) and -w waits
# for the iptables lock instead of failing outright if another process holds it momentarily.
ExecStart=/bin/sh -c 'iptables -w -C DOCKER-USER -s 172.30.90.0/24 -d 169.254.169.254/32 -j DROP 2>/dev/null || iptables -w -I DOCKER-USER -s 172.30.90.0/24 -d 169.254.169.254/32 -j DROP'
ExecStart=/bin/sh -c 'iptables -w -C DOCKER-USER -s 172.30.90.0/24 -d 100.64.0.0/10 -j DROP 2>/dev/null || iptables -w -I DOCKER-USER -s 172.30.90.0/24 -d 100.64.0.0/10 -j DROP'
ExecStart=/bin/sh -c 'iptables -w -C DOCKER-USER -s 172.30.90.0/24 -o tailscale0 -j DROP 2>/dev/null || iptables -w -I DOCKER-USER -s 172.30.90.0/24 -o tailscale0 -j DROP'
ExecStart=/bin/sh -c 'iptables -w -C INPUT -s 172.30.90.0/24 -d 100.64.0.0/10 -j DROP 2>/dev/null || iptables -w -I INPUT -s 172.30.90.0/24 -d 100.64.0.0/10 -j DROP'
ExecStop=/bin/sh -c 'iptables -w -D DOCKER-USER -s 172.30.90.0/24 -d 169.254.169.254/32 -j DROP 2>/dev/null || true'
ExecStop=/bin/sh -c 'iptables -w -D DOCKER-USER -s 172.30.90.0/24 -d 100.64.0.0/10 -j DROP 2>/dev/null || true'
ExecStop=/bin/sh -c 'iptables -w -D DOCKER-USER -s 172.30.90.0/24 -o tailscale0 -j DROP 2>/dev/null || true'
ExecStop=/bin/sh -c 'iptables -w -D INPUT -s 172.30.90.0/24 -d 100.64.0.0/10 -j DROP 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
